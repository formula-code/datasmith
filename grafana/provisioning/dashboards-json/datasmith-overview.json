      "datasource": {
        "uid": "supabase-pg",
        "type": "postgres"
      },
      "targets": [
        {
          "rawSql": "SELECT owner || '/' || repo AS repository, stars FROM repositories WHERE stars IS NOT NULL ORDER BY stars DESC;",
